FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY apps/web/bridge/requirements.txt* ./
RUN pip install --no-cache-dir fastapi uvicorn websockets || true

# Copy bridge code
COPY apps/web/bridge/ .

EXPOSE 3002

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "3002", "--log-level", "info"]
