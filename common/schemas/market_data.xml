<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="mach_zero.market_data"
                   id="1"
                   version="1"
                   semanticVersion="1.0"
                   description="Unified Internal Market Data Schema"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Standard SBE Header">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId"  primitiveType="uint16"/>
            <type name="schemaId"    primitiveType="uint16"/>
            <type name="version"     primitiveType="uint16"/>
        </composite>
        <enum name="Side" encodingType="uint8">
            <validValue name="Buy">1</validValue>
            <validValue name="Sell">2</validValue>
            <validValue name="Unknown">0</validValue>
        </enum>
        <type name="Price" primitiveType="int64"/>
        <type name="Quantity" primitiveType="uint64"/>
        <type name="Timestamp" primitiveType="uint64" description="Nanoseconds since Epoch"/>
    </types>

    <sbe:message name="Trade" id="1" description="Trade Execution Message">
        <field name="symbolId"   id="1" type="uint64"/>
        <field name="price"      id="2" type="Price"/>
        <field name="quantity"   id="3" type="Quantity"/>
        <field name="side"       id="4" type="Side"/>
        <field name="timestamp"  id="5" type="Timestamp"/>
    </sbe:message>
</sbe:messageSchema>