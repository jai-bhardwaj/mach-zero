<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="mach_zero.market_data"
                   id="2"
                   version="3"
                   semanticVersion="3.0"
                   description="Unified Internal Market Data Schema (tenant-aware)"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Standard SBE Header">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId"  primitiveType="uint16"/>
            <type name="schemaId"    primitiveType="uint16"/>
            <type name="version"     primitiveType="uint16"/>
        </composite>

        <!-- Enums -->
        <enum name="Side" encodingType="uint8">
            <validValue name="Buy">1</validValue>
            <validValue name="Sell">2</validValue>
            <validValue name="Unknown">0</validValue>
        </enum>

        <enum name="Venue" encodingType="uint8" description="Exchange venue identifier">
            <validValue name="Unknown">0</validValue>
            <validValue name="Binance">1</validValue>
            <validValue name="NSE">2</validValue>
            <validValue name="BSE">3</validValue>
        </enum>

        <enum name="OrderType" encodingType="uint8" description="Order type">
            <validValue name="Market">0</validValue>
            <validValue name="Limit">1</validValue>
            <validValue name="IOC">2</validValue>
            <validValue name="FOK">3</validValue>
        </enum>

        <enum name="TimeInForce" encodingType="uint8" description="Time in force">
            <validValue name="Day">0</validValue>
            <validValue name="GTC">1</validValue>
            <validValue name="IOC">2</validValue>
            <validValue name="FOK">3</validValue>
        </enum>

        <enum name="OrderStatus" encodingType="uint8" description="Order lifecycle status">
            <validValue name="New">0</validValue>
            <validValue name="PartialFill">1</validValue>
            <validValue name="Filled">2</validValue>
            <validValue name="Cancelled">3</validValue>
            <validValue name="Rejected">4</validValue>
            <validValue name="PendingNew">5</validValue>
            <validValue name="PendingCancel">6</validValue>
        </enum>

        <enum name="RejectReason" encodingType="uint8" description="Order reject reason">
            <validValue name="None">0</validValue>
            <validValue name="PriceBand">1</validValue>
            <validValue name="PositionLimit">2</validValue>
            <validValue name="OrderRate">3</validValue>
            <validValue name="MaxOrderSize">4</validValue>
            <validValue name="KillSwitch">5</validValue>
            <validValue name="InsufficientFunds">6</validValue>
            <validValue name="InvalidSymbol">7</validValue>
            <validValue name="ExchangeReject">8</validValue>
            <validValue name="InvalidTenant">9</validValue>
        </enum>

        <enum name="RiskCommandType" encodingType="uint8" description="Risk command type">
            <validValue name="KillSwitchOn">0</validValue>
            <validValue name="KillSwitchOff">1</validValue>
            <validValue name="ResetPositions">2</validValue>
        </enum>

        <enum name="SquareOffScope" encodingType="uint8" description="Square-off scope">
            <validValue name="Symbol">0</validValue>
            <validValue name="All">1</validValue>
        </enum>

        <!-- Semantic types -->
        <type name="Price" primitiveType="int64" description="Fixed-point price (8 decimal places)"/>
        <type name="Quantity" primitiveType="uint64"/>
        <type name="Timestamp" primitiveType="uint64" description="Nanoseconds since Epoch"/>

        <!-- Composite for order book price levels (used in Quote groups) -->
        <composite name="PriceLevel" description="Single price level in the order book">
            <type name="price"    primitiveType="int64"/>
            <type name="quantity" primitiveType="uint64"/>
        </composite>
    </types>

    <!-- ========== Market Data Messages ========== -->

    <sbe:message name="Trade" id="1" description="Trade Execution Message">
        <field name="symbolId"   id="1" type="uint64"/>
        <field name="price"      id="2" type="Price"/>
        <field name="quantity"   id="3" type="Quantity"/>
        <field name="side"       id="4" type="Side"/>
        <field name="venue"      id="5" type="Venue"/>
        <field name="timestamp"  id="6" type="Timestamp"/>
    </sbe:message>

    <sbe:message name="Quote" id="2" description="Order Book Update Message">
        <field name="symbolId"       id="1" type="uint64"/>
        <field name="bidPrice"       id="2" type="Price"/>
        <field name="bidQuantity"    id="3" type="Quantity"/>
        <field name="askPrice"       id="4" type="Price"/>
        <field name="askQuantity"    id="5" type="Quantity"/>
        <field name="venue"          id="6" type="Venue"/>
        <field name="sequenceNumber" id="7" type="uint64"/>
        <field name="timestamp"      id="8" type="Timestamp"/>
    </sbe:message>

    <!-- ========== Order Messages ========== -->

    <sbe:message name="OrderRequest" id="10" description="New Order Request">
        <field name="orderId"        id="1"  type="uint64"/>
        <field name="clientOrderId"  id="2"  type="uint64"/>
        <field name="symbolId"       id="3"  type="uint64"/>
        <field name="side"           id="4"  type="Side"/>
        <field name="price"          id="5"  type="Price"/>
        <field name="quantity"       id="6"  type="Quantity"/>
        <field name="orderType"      id="7"  type="OrderType"/>
        <field name="timeInForce"    id="8"  type="TimeInForce"/>
        <field name="venue"          id="9"  type="Venue"/>
        <field name="timestamp"      id="10" type="Timestamp"/>
        <field name="tenantId"       id="11" type="uint32"/>
    </sbe:message>

    <sbe:message name="OrderAck" id="11" description="Order Acknowledgement">
        <field name="orderId"          id="1"  type="uint64"/>
        <field name="clientOrderId"    id="2"  type="uint64"/>
        <field name="symbolId"         id="3"  type="uint64"/>
        <field name="status"           id="4"  type="OrderStatus"/>
        <field name="filledQuantity"   id="5"  type="Quantity"/>
        <field name="avgPrice"         id="6"  type="Price"/>
        <field name="exchangeOrderId"  id="7"  type="uint64"/>
        <field name="venue"            id="8"  type="Venue"/>
        <field name="timestamp"        id="9"  type="Timestamp"/>
        <field name="tenantId"         id="10" type="uint32"/>
    </sbe:message>

    <sbe:message name="OrderReject" id="12" description="Order Rejection">
        <field name="orderId"        id="1" type="uint64"/>
        <field name="clientOrderId"  id="2" type="uint64"/>
        <field name="rejectReason"   id="3" type="RejectReason"/>
        <field name="venue"          id="4" type="Venue"/>
        <field name="timestamp"      id="5" type="Timestamp"/>
        <field name="tenantId"       id="6" type="uint32"/>
    </sbe:message>

    <sbe:message name="CancelRequest" id="13" description="Order Cancel Request">
        <field name="orderId"        id="1" type="uint64"/>
        <field name="clientOrderId"  id="2" type="uint64"/>
        <field name="symbolId"       id="3" type="uint64"/>
        <field name="venue"          id="4" type="Venue"/>
        <field name="timestamp"      id="5" type="Timestamp"/>
        <field name="tenantId"       id="6" type="uint32"/>
    </sbe:message>

    <!-- ========== System Messages ========== -->

    <sbe:message name="Heartbeat" id="99" description="System Heartbeat">
        <field name="sourceId"       id="1" type="uint64"/>
        <field name="sequenceNumber" id="2" type="uint64"/>
        <field name="timestamp"      id="3" type="Timestamp"/>
    </sbe:message>

    <sbe:message name="RiskCommand" id="20" description="Risk Control Command">
        <field name="commandType" id="1" type="RiskCommandType"/>
        <field name="timestamp"   id="2" type="Timestamp"/>
        <field name="tenantId"    id="3" type="uint32"/>
    </sbe:message>

    <sbe:message name="SquareOffCommand" id="21" description="Square Off Position(s)">
        <field name="symbolId"  id="1" type="uint64"/>
        <field name="scope"     id="2" type="SquareOffScope"/>
        <field name="venue"     id="3" type="Venue"/>
        <field name="timestamp" id="4" type="Timestamp"/>
        <field name="tenantId"  id="5" type="uint32"/>
    </sbe:message>
</sbe:messageSchema>
