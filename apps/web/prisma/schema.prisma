generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum TradingMode {
  MOCK
  LIVE
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model Tenant {
  id            String      @id @default(uuid())
  name          String      @unique
  slug          String      @unique
  active        Boolean     @default(true)
  plan          Plan        @default(FREE)
  config        Json?
  createdAt     DateTime    @default(now())

  users         User[]
  strategies    StrategyConfig[]
  accounts      TradingAccount[]
  auditLogs     AuditLog[]
  capitalPools  CapitalPool[]
  subscriptions StrategySubscription[]
  savedViews    SavedTableView[]
  invites       WorkspaceInvite[]
  notificationChannels NotificationChannel[]
  alerts               Alert[]
  mapping              TenantMapping?
  billing              Billing?
}

// Stripe customer + subscription state. One per tenant. Created lazily
// at first checkout attempt; the webhook keeps it in sync.
model Billing {
  id                   String    @id @default(uuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  // Mirror of Stripe's subscription.status: active, trialing, past_due,
  // canceled, unpaid, incomplete, incomplete_expired, paused.
  status               String    @default("incomplete")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stripeCustomerId])
}

// Maps Tenant.id (UUID) to an engine-internal uint32 engineId, which is
// the form the C++ trading engine uses on the wire (SBE OrderRequest.tenantId
// etc.). Autoincrement sequence — never reused, never collides. engineId=0
// is reserved for the global admin kill switch and is never assigned.
//
// Seed/migration must ensure sequence starts at >= 1 (Postgres default is 1).
// MAX_TENANTS in the engine is 1024; exceeding that requires a code change
// and redeploy.
model TenantMapping {
  engineId  Int      @id @default(autoincrement())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model User {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  username           String
  email              String   @unique
  password           String   @default("")
  role               Role     @default(VIEWER)
  active             Boolean  @default(true)
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())

  auditLogs    AuditLog[]
  authAccounts AuthAccount[]
  savedViews   SavedTableView[]

  @@unique([tenantId, username])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RISK_MANAGER
  TRADER
  VIEWER
}

model TradingAccount {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  name          String
  venue         String
  segments      String[]
  active        Boolean   @default(true)
  config        Json?
  status        String    @default("disconnected")
  statusMessage String?
  testnet       Boolean   @default(true)
  lastCheckedAt DateTime?
  permissions   String[]
  createdAt     DateTime  @default(now())

  strategies   StrategyConfig[]
  capitalPools CapitalPool[]

  @@unique([tenantId, name])
}

enum StrategyStatus {
  RUNNING
  PAUSED
  STOPPED
  PENDING
}

model StrategyConfig {
  id               String          @id @default(uuid())
  // Stable integer id carried on the SBE hot path (OrderRequest.strategyId) so
  // QuestDB executions join back to the strategy/account/mode in the web.
  // Mirrors TenantMapping.engineId; the engine config export uses it.
  engineId         Int             @unique @default(autoincrement())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  accountId        String?
  account          TradingAccount? @relation(fields: [accountId], references: [id])
  name             String
  type             String
  symbolId         Int
  symbolName       String
  venue            String
  status           StrategyStatus  @default(PENDING)
  tradingMode      TradingMode     @default(MOCK)
  modeChangedAt    DateTime?
  params           Json
  maxPositionLimit Float?
  maxOrderRate     Int?
  maxDrawdown      Float?
  riskMultiplier   Float           @default(1.0)
  configVersion    Int             @default(1)
  updatedAt        DateTime        @updatedAt
  updatedBy        String?

  allocation    CapitalAllocation?
  subscription  StrategySubscription?
  configHistory StrategyConfigHistory[]

  @@unique([tenantId, name])
}

model CapitalPool {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  accountId      String
  account        TradingAccount @relation(fields: [accountId], references: [id])
  totalCapital   Float
  allocatedTotal Float          @default(0)
  reservedMargin Float          @default(0)
  currency       String         @default("USD")
  updatedAt      DateTime       @updatedAt

  allocations CapitalAllocation[]

  @@unique([tenantId, accountId])
}

model CapitalAllocation {
  id           String         @id @default(uuid())
  poolId       String
  pool         CapitalPool    @relation(fields: [poolId], references: [id])
  strategyId   String         @unique
  strategy     StrategyConfig @relation(fields: [strategyId], references: [id])
  allocatedAmt Float
  usedMargin   Float          @default(0)
  maxDrawdown  Float?
  updatedAt    DateTime       @updatedAt
}

enum StrategyCategory {
  MARKET_MAKING
  MOMENTUM
  ARBITRAGE
  MEAN_REVERSION
  TREND_FOLLOWING
  STATISTICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model StrategyTemplate {
  id              String           @id @default(uuid())
  name            String           @unique
  slug            String           @unique
  description     String
  longDescription String?
  type            String
  category        StrategyCategory
  riskLevel       RiskLevel
  params          Json
  symbolIds       Int[]
  version         String           @default("1.0.0")
  returnPct       Float            @default(0)
  winRate         Float            @default(0)
  maxDrawdown     Float            @default(0)
  sharpeRatio     Float            @default(0)
  totalTrades     Int              @default(0)
  featured        Boolean          @default(false)
  active          Boolean          @default(true)
  minCapital      Float            @default(0)
  maxDrawdownPct  Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscriptions StrategySubscription[]
}

model StrategySubscription {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  templateId   String
  template     StrategyTemplate @relation(fields: [templateId], references: [id])
  strategyId   String           @unique
  strategy     StrategyConfig   @relation(fields: [strategyId], references: [id])
  subscribedAt DateTime         @default(now())
  subscribedBy String?

  @@unique([tenantId, templateId])
  @@index([tenantId])
}

// OAuth account linking (NextAuth adapter)
model AuthAccount {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

// Email magic link verification tokens (NextAuth adapter)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkspaceInvite {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  email     String
  role      Role      @default(VIEWER)
  invitedBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, email])
  @@index([email])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  timestamp DateTime @default(now())

  @@index([tenantId, timestamp])
}

model SavedTableView {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  tableId   String   // "trades" | "orders" | "risk_events" | "positions" | "users"
  config    Json     // { filters, sorting, columnVisibility, pageSize }
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tableId, name])
  @@index([tenantId, tableId])
}

model StrategyConfigHistory {
  id               String         @id @default(uuid())
  strategyId       String
  strategy         StrategyConfig @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  configVersion    Int
  params           Json
  maxPositionLimit Float?
  maxOrderRate     Int?
  maxDrawdown      Float?
  riskMultiplier   Float          @default(1.0)
  changedBy        String?
  changedAt        DateTime       @default(now())

  @@index([strategyId, configVersion])
}

enum NotificationChannelType {
  EMAIL
  WEBHOOK
  SLACK
}

enum AlertTriggerType {
  RISK_BREACH
  KILL_SWITCH
  ORDER_FILL
  STRATEGY_STATUS_CHANGE
  PNL_THRESHOLD
  DRAWDOWN_THRESHOLD
}

model NotificationChannel {
  id        String                  @id @default(uuid())
  tenantId  String
  tenant    Tenant                  @relation(fields: [tenantId], references: [id])
  name      String
  type      NotificationChannelType
  config    Json
  enabled   Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  alerts           Alert[]
  notificationLogs NotificationLog[]

  @@unique([tenantId, name])
}

model Alert {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  name       String
  trigger    AlertTriggerType
  conditions Json
  channelId  String
  channel    NotificationChannel @relation(fields: [channelId], references: [id])
  enabled    Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  notificationLogs NotificationLog[]

  @@unique([tenantId, name])
}

model NotificationLog {
  id        String              @id @default(uuid())
  tenantId  String
  channelId String
  channel   NotificationChannel @relation(fields: [channelId], references: [id])
  alertId   String?
  alert     Alert?              @relation(fields: [alertId], references: [id])
  subject   String
  body      String
  status    String
  error     String?
  sentAt    DateTime            @default(now())

  @@index([tenantId, sentAt])
}
