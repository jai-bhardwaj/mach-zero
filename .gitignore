# ==========================================
# Mach-Zero Monorepo GitIgnore
# ==========================================

# --- [ C++ Build ] ---
build/
bin/
obj/
*.o
*.obj
*.so
*.so.*
*.dylib
*.a
*.lib
*.exe
*.out
cmake_install.cmake
CMakeCache.txt
CMakeFiles/
_deps/
.cache/

# --- [ Node / Web ] ---
node_modules/
.next/
.vercel/
.turbo/
# package-lock.json  # Needed for CI

# --- [ Python Ecosystem ] ---
__pycache__/
*.py[cod]
*$py.class
.Python
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/

# Notebooks & Tooling
.ipynb_checkpoints/
.ruff_cache/

# --- [ Environment / Secrets ] ---
.env
.env.*
!.env.production.example
secrets/
.auth/
*.pem
*.key
*.pub
credentials.json
api_keys.json

# --- [ Infrastructure & Cloud ] ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
override.tf
override.tf.json
infra/data/

# --- [ Data / Logs ] ---
data/
*.parquet
*.csv
*.log
core.*

# --- [ Shared Memory ] ---
*.shm
*.mmap

# --- [ IDE / OS ] ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- [ Claude Code ] ---
.claude/worktrees/

